{
  "name": "jwt-inspector",
  "version": "0.0.0",
  "private": true,
  "description": "Browser side panel to detect, inspect, verify and craft JSON Web Tokens.",
  "license": "MIT",
  "author": "lggutierrez0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lggutierrez0/jwt-inspector.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && playwright test",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "@wxt-dev/i18n": "0.2.7",
    "@wxt-dev/module-react": "1.2.2",
    "audit-ci": "7.1.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "12.6.0"
  },
  "packageManager": "pnpm@12.6.0"
}
